{
  "name": "arr-command-center",
  "version": "1.0.0",
  "description": "A locally-hosted dashboard to manage Sonarr, Radarr, Overseerr/Seerr and SABnzbd behind Cloudflare Access. A self-hosted LunaSea replacement.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "demo": "MOCK=1 node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test server/test/*.test.js test/*.test.js",
    "ios:add": "cap add ios",
    "ios:copy": "cap copy ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=23"
  },
  "dependencies": {
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/ios": "^6.2.2",
    "express": "^4.22.2",
    "web-push": "^3.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
