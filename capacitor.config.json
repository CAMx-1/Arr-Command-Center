{
  "appId": "app.arrcommandcenter.mobile",
  "appName": "Arr Command Center",
  "webDir": "public",
  "server": {
    "iosScheme": "capacitor",
    "cleartext": true,
    "allowNavigation": [
      "arrcc.arr-matey.com",
      "*.arr-matey.com",
      "*.cloudflareaccess.com",
      "*.plex.tv",
      "plex.tv",
      "app.plex.tv"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0f1117",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 0,
      "launchFadeOutDuration": 220,
      "backgroundColor": "#0f1117",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "dark",
      "backgroundColor": "#0f1117"
    }
  }
}
