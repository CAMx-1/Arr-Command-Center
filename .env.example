# Arr Command Center — environment variable overrides
# Any value set here overrides the equivalent value in config.json.
# This is handy for Docker / secrets management so you don't commit keys.

# Server
PORT=7373
# Bind to localhost by default. Only expose on 0.0.0.0 if an auth method is enabled.
HOST=127.0.0.1

# Set to 1 to run bundled MOCK services for local testing (no real services needed)
MOCK=0

# Session security (Plex auth)
# SECURE_COOKIES=true   # add the Secure flag to the session cookie (use behind HTTPS)
# SESSION_SECRET=        # override the auto-generated HMAC secret (rotating logs everyone out)
# PLEX_ALLOW_ANY=false   # allow any Plex account when no allowlist is set (NOT recommended)

# Optional dashboard basic-auth (protects the whole UI + proxy)
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# ---- Per-service overrides ----
# Pattern: <SERVICE>_BASE_URL, <SERVICE>_API_KEY,
#          <SERVICE>_CF_CLIENT_ID, <SERVICE>_CF_CLIENT_SECRET

SONARR_BASE_URL=
SONARR_API_KEY=
SONARR_CF_CLIENT_ID=
SONARR_CF_CLIENT_SECRET=

RADARR_BASE_URL=
RADARR_API_KEY=
RADARR_CF_CLIENT_ID=
RADARR_CF_CLIENT_SECRET=

OVERSEERR_BASE_URL=
OVERSEERR_API_KEY=
OVERSEERR_CF_CLIENT_ID=
OVERSEERR_CF_CLIENT_SECRET=

SABNZBD_BASE_URL=
SABNZBD_API_KEY=
SABNZBD_CF_CLIENT_ID=
SABNZBD_CF_CLIENT_SECRET=

TAUTULLI_BASE_URL=
TAUTULLI_API_KEY=
TAUTULLI_CF_CLIENT_ID=
TAUTULLI_CF_CLIENT_SECRET=
